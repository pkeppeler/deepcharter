#!/usr/bin/env bash
# Usage: tools/py <python arguments>   (for example: tools/py tools/feature_map.py --check)
# Runs the repo's Python through uv on the interpreter that `.python-version` names, isolated (`-I`). The tools use only the
# standard library, so there is no project or lock (`--no-project`). A bare `python3` depends on PATH and can be the system 3.9 (#710).
set -euo pipefail

root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd -P)
if ! command -v uv >/dev/null 2>&1; then
  echo "tools/py: uv not found on PATH; the tools run through it. Install it (brew install uv, or https://docs.astral.sh/uv/getting-started/installation/)." >&2
  exit 127
fi
if [[ ! -r $root/.python-version ]]; then
  echo "tools/py: $root/.python-version is missing; it names the Python version the tools run on." >&2
  exit 1
fi
version=$(<"$root/.python-version")
exec uv run --no-project --python "$version" python -I "$@"

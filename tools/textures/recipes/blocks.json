        "kind": "opaque",
        "layers": [
          {"op": "noise", "ramp": "$ground", "seed": "$seed", "cell": 8, "octaves": 3, "dither": 0.9},
          {"op": "speckle", "colours": "$grains", "density": 0.08, "seed": "$seed"},
          {"op": "ore", "seed": "$seed", "count": "$count", "shapes": ["chip", "fleck", "pebble"], "ramp": "$pebbles"}
        ]
      }
    },
    "surface_beds": {

#!/usr/bin/env bash
# Fast pre-push check, early feedback only. What it runs and how to enable it: docs/tooling/pre-push-hook.md
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

# core.hooksPath may be one absolute path shared by every worktree. Run the copy of the hook that belongs to the tree being pushed,
# so a branch is checked by its own hook, against its own sources.
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
  top=$(cd "$top" && pwd -P)
  if [[ $top != "$root" && -x $top/.githooks/pre-push ]]; then
    exec "$top/.githooks/pre-push" "$@"
  fi
  root=$top
fi

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# Run the checks unless every ref is a branch delete or targets pr-media. The Gradle-backed steps (compile, checkstyle, gate fixture
# checks, minutes on a cold daemon) also run unless every checked ref changes nothing Gradle reads. CI runs everything either way.
gradle_inputs='^(src/|gradle/|config/|gradlew|gradle\.properties$|[^/]*\.lockfile$|([^/]*/)*[^/]*\.gradle\.kts$|tools/[^/]*\.java$|tools/tests/(gate_checks|gate_batch|[a-z_]*_gate_check)\.py$)'
touches_gradle_inputs() { # <local sha> <remote sha>; an unknown base counts as a yes
  local base files
  if [[ $2 =~ ^0+$ ]]; then
    base=$(git -C "$root" merge-base "$1" origin/main 2>/dev/null) || return 0
  else
    base=$2
  fi
  files=$(git -C "$root" diff --name-only "$base" "$1" 2>/dev/null) || return 0
  grep -qE "$gradle_inputs" <<<"$files"
}
# Time budget printed before the Gradle run (measured on a warm cache, see docs/tooling/pre-push-hook.md).
budget_warm=420
budget_cold=900
need_checks=0
need_gradle=0
while read -r _ local_sha remote_ref remote_sha || [[ -n ${local_sha:-} ]]; do
  [[ $local_sha =~ ^0+$ ]] && continue
  [[ $remote_ref == refs/heads/pr-media ]] && continue
  need_checks=1
  if touches_gradle_inputs "$local_sha" "$remote_sha"; then need_gradle=1; fi
done
[[ $need_checks -eq 1 ]] || exit 0

# The tools run through tools/py: uv on the Python in .python-version, so the PATH's python3 never matters (#710).
# This probe fails first, with tools/py's message, instead of inside the first check.
"$root/tools/py" -c pass || exit 1

cd "$root"
# Git exports GIT_DIR and its siblings to a hook; a test that runs git in a temp repo must not inherit them.
unset "${!GIT_@}"
fail() {
  echo "pre-push: $1 failed. Fix it. --no-verify is for the cases docs/tooling/pre-push-hook.md lists" >&2
  exit 1
}
# Gradle runs under the clone's shared slot lock, so the hook and the agents queue instead of racing. DEEPCHARTER_GRADLE_LOCK overrides the
# path. Without flock (macOS has none) or without a git dir to put the lock in, it runs unlocked.
gradle_lock=${DEEPCHARTER_GRADLE_LOCK:-}
if [[ -z $gradle_lock ]] && common=$(git rev-parse --git-common-dir 2>/dev/null) && common=$(cd "$common" && pwd -P); then
  gradle_lock=$common/gradle-slot.lock
fi
# -o: the Gradle client and daemon do not inherit the lock fd. -w: give up after DEEPCHARTER_GRADLE_LOCK_WAIT seconds (exit 200) rather than hang.
# Exit code of a failed lock step, so the Gradle pipeline can tell it from a failed build (the lock step has already printed why).
lock_failed=3
gradle_lock_wait=${DEEPCHARTER_GRADLE_LOCK_WAIT:-1800}
with_gradle_lock() { # with_gradle_lock <command>...
  if [[ -z $gradle_lock ]] || ! command -v flock >/dev/null 2>&1; then "$@"; return; fi
  if ! { : >>"$gradle_lock"; } 2>/dev/null; then
    echo "pre-push: cannot open the Gradle lock file $gradle_lock. Fix its path or permissions, or skip the hook once with: git push --no-verify" >&2
    exit "$lock_failed"
  fi
  local rc=0
  flock -o -w "$gradle_lock_wait" -E 200 "$gradle_lock" "$@" || rc=$?
  if [[ $rc -eq 200 ]]; then
    echo "pre-push: timed out after $gradle_lock_wait s waiting for the Gradle lock $gradle_lock. Retry later, or skip the hook once with: git push --no-verify" >&2
    exit "$lock_failed"
  fi
  return "$rc"
}
echo "pre-push: conflict markers" >&2
tools/py tools/tests/conflict_markers.py \
  || fail "conflict markers"
if [[ $need_gradle -eq 1 ]]; then
  # CI's build-checks job, minus the server GameTests, in one Gradle run: every source set compiles, then `check` runs spotlessCheck,
  # checkstyle, buildHealth, generateGametestModJson and every gate. Gradle skips up-to-date tasks, so a warm run redoes only what the
  # branch changed. Dependencies resolve from Maven Central, or from the ADR 0101 mirror when its init script is in the Gradle home.
  echo "pre-push: Gradle checks (compile, spotless, checkstyle, every gate): about $budget_warm s warm, up to $budget_cold s on a cold" \
    "daemon or cache; waits if another Gradle build holds the lock. Ctrl-C and push with --no-verify to skip." >&2
  gradle_log=$(mktemp)
  trap 'rm -f "$gradle_log"' EXIT
  gradle_start=$SECONDS
  rc=0
  with_gradle_lock ./gradlew --console=plain compileJava compileClientJava compileGametestJava check -x runGameTest 2>&1 \
    | tee "$gradle_log" >&2 || rc=${PIPESTATUS[0]}
  if [[ $rc -eq $lock_failed ]]; then exit 1; fi
  if [[ $rc -ne 0 ]]; then
    failed_task=$(grep -oE "^> Task [^ ]+ FAILED|Execution failed for task '[^']+'" "$gradle_log" | head -n 1 \
      | sed -E "s/^> Task ([^ ]+) FAILED/\1/; s/^Execution failed for task '([^']+)'/\1/" || true)
    fail "Gradle task ${failed_task:-(none named, see the Gradle output above)}"
  fi
  echo "pre-push: Gradle checks passed in $((SECONDS - gradle_start)) s" >&2
else
  echo "pre-push: no Gradle input changed in the pushed range, skipping the Gradle checks and gate checks (CI runs them)" >&2
fi
echo "pre-push: tool unit tests" >&2
tools/py -m unittest discover -s tools/tests -p 'test_*.py' \
  || fail "tool unit tests"
echo "pre-push: shellcheck" >&2
if command -v shellcheck >/dev/null 2>&1; then
  tools/shellcheck.sh || fail "shellcheck"
else
  echo "pre-push: shellcheck not found, skipping it (CI runs it)" >&2
fi
if [[ $need_gradle -eq 1 ]]; then
  echo "pre-push: gate checks on fixtures (one Gradle run)" >&2
  with_gradle_lock tools/py tools/tests/gate_checks.py \
    || fail "gate checks"
fi

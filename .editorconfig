root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml,md,mcmeta}]
indent_size = 2

# The Gradle Kotlin DSL files in this repo are tab-indented; Spotless does not touch them.
[*.kts]
indent_style = tab
